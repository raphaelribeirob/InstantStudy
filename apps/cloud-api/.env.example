# Provision a NEW, dedicated Neon database/branch before deployment. Never point
# Instant Cloud at existing production product databases without migration review.
INSTANT_CLOUD_DATABASE_URL=
# Auth0 issuer must exactly equal the signed JWT iss, usually with trailing /.
INSTANT_CLOUD_OAUTH_ISSUER=https://YOUR_AUTH0_DOMAIN/
INSTANT_CLOUD_OAUTH_AUDIENCE=https://instant-cloud.example.com
# No bearer keys or credentials in frontend / mobile / plugin packages.
