# Adapty central paywall / experiment orchestration.
# Use the dedicated InstantPayments Adapty app. Never expose the secret key to VITE_*.
ADAPTY_PUBLIC_API_KEY=
ADAPTY_SECRET_API_KEY=
ADAPTY_STORE=paddle
ADAPTY_PLACEMENT_ID=instant_pay_main
ADAPTY_PLACEMENT_INSTANT_SPEAK=
ADAPTY_PLACEMENT_INSTANT_STUDY=
ADAPTY_PLACEMENT_INSTANT_BIBLE=
ADAPTY_PLACEMENT_INSTANT_VEST=
ADAPTY_PLACEMENT_INSTANT_CLOSER=
ADAPTY_PLACEMENT_DOTSPEAK=
ADAPTY_PLACEMENT_INSTANT_ONE=

# Paddle server-side only
PADDLE_ENV=sandbox
PADDLE_API_KEY=
PADDLE_HOSTED_CHECKOUT_URL=

# Server-side offer -> Paddle price mapping
PADDLE_PRICE_INSTANT_SPEAK_PRO_MONTHLY=
PADDLE_PRICE_INSTANT_SPEAK_PRO_ANNUAL=
PADDLE_PRICE_INSTANT_STUDY_PLUS_MONTHLY=
PADDLE_PRICE_INSTANT_STUDY_PLUS_ANNUAL=
PADDLE_PRICE_INSTANT_STUDY_UNLIMITED_MONTHLY=
PADDLE_PRICE_INSTANT_STUDY_UNLIMITED_ANNUAL=
PADDLE_PRICE_INSTANT_BIBLE_PRO_MONTHLY=
PADDLE_PRICE_INSTANT_BIBLE_PRO_ANNUAL=
PADDLE_PRICE_INSTANT_VEST_PRO_MONTHLY=
PADDLE_PRICE_INSTANT_VEST_PRO_ANNUAL=
PADDLE_PRICE_INSTANT_CLOSER_PRO_MONTHLY=
PADDLE_PRICE_INSTANT_CLOSER_PRO_ANNUAL=
PADDLE_PRICE_DOTSPEAK_PREMIUM_MONTHLY=
PADDLE_PRICE_DOTSPEAK_PREMIUM_ANNUAL=
PADDLE_PRICE_INSTANT_ONE_MONTHLY=
PADDLE_PRICE_INSTANT_ONE_ANNUAL=

# Paddle notification destination secret. Required by /api/webhook.
PADDLE_WEBHOOK_SECRET=

# Signed identity bridge for InstantCloser.
# Use the same random secret in InstantCloser as INSTANT_PAY_WEBHOOK_SECRET.
INSTANT_CLOSER_SHARED_SECRET=
INSTANT_CLOSER_ENTITLEMENT_WEBHOOK_URL=
