# Paddle server-side only
PADDLE_ENV=sandbox
PADDLE_API_KEY=
PADDLE_HOSTED_CHECKOUT_URL=
PADDLE_WEBHOOK_SECRET=
PADDLE_WEBHOOK_TOLERANCE_SECONDS=300

# Central ledger (Neon/Postgres)
DATABASE_URL=

# Authenticated Instant Account identity endpoint. It must accept the user's
# Bearer token and return { id|sub|user_id, email }.
INSTANT_ACCOUNT_INTROSPECTION_URL=

# Server-side offer -> Paddle price mapping
PADDLE_PRICE_INSTANT_SPEAK_PRO_MONTHLY=
PADDLE_PRICE_INSTANT_SPEAK_PRO_ANNUAL=
