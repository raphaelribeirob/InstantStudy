      "type": "streamable-http",
      "url": "https://instantstudy-api.vercel.app/mcp/chatgpt",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "baseScopes": [
              "study:read",
              "study:write"
