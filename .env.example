PORT=8000

# Development-only single device binding.
# Production must derive the device from authenticated user identity.
INSTANTSTUDY_DEVICE_ID=dev-device
INSTANTSTUDY_BRIDGE_TOKEN=replace-me

# Maximum time an MCP tool waits for the local Anki bridge.
ANKI_COMMAND_TIMEOUT_MS=15000

# Durable study sessions, cross-session mastery and due-review scheduling.
# In production, provision Neon and set the injected DATABASE_URL.
DATABASE_URL=

# Production fails closed when durable storage is absent. Local development
# may set this to false to use in-memory persistence.
INSTANTSTUDY_REQUIRE_DATABASE=true

# Provider-neutral REST/OpenAPI access for non-MCP LLM clients.
# Server-side only. Never expose through VITE_*.
INSTANTSTUDY_API_KEY=replace-me-api-key

# Remote MCP authentication. Falls back to INSTANTSTUDY_API_KEY only when
# omitted, but production should use a dedicated rotated credential.
INSTANTSTUDY_MCP_API_KEY=replace-me-mcp-key

# Administrative entitlement mutations require a separate credential.
INSTANTSTUDY_ADMIN_API_KEY=replace-me-admin-key

# Adapty pricing experiments. Leave blank to disable monetization lookup locally.
ADAPTY_PUBLIC_API_KEY=
ADAPTY_SECRET_API_KEY=
ADAPTY_PLACEMENT_ID=instantstudy_main
ADAPTY_STORE=stripe

# Standalone software -> server-side web proxy -> InstantStudy API.
# Never expose the API key through VITE_*.
INSTANTSTUDY_API_URL=http://127.0.0.1:8000

# Public origin used to publish MCP/OpenAPI connection metadata.
INSTANTSTUDY_PUBLIC_URL=https://YOUR_INSTANTSTUDY_HOST

# Marketing page connection buttons.
VITE_INSTANTSTUDY_MCP_URL=https://YOUR_INSTANTSTUDY_HOST/mcp
VITE_INSTANTSTUDY_OPENAPI_URL=https://YOUR_INSTANTSTUDY_HOST/openapi.yaml



# Awesome Free LLM APIs is a provider DIRECTORY; each key belongs to its provider.
# Only place keys on the server (InstantStudy API), never in VITE_* or Flutter.
# Free tiers have account/model/rate limits. No 100% free SLA is guaranteed.
GROQ_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=

# Text inference: free-first (Groq -> OpenRouter -> Gemini), no surprise paid calls.
# Requires actual provider credentials and an explicit operator enable switch.
INSTANTSTUDY_FREE_LLM_ENABLED=false
INSTANTSTUDY_FREE_LLM_ORDER=groq,openrouter,gemini
INSTANTSTUDY_FREE_LLM_MAX_ATTEMPTS=2
INSTANTSTUDY_FREE_LLM_TIMEOUT_MS=9000
INSTANTSTUDY_GROQ_MODEL=openai/gpt-oss-20b
INSTANTSTUDY_OPENROUTER_MODEL=openai/gpt-oss-20b:free
INSTANTSTUDY_GEMINI_MODEL=gemini-2.5-flash

# Audio: free-tier Groq Whisper is attempted only when enabled.
INSTANTSTUDY_FREE_AUDIO_ENABLED=false
# Image notes: use Gemini multimodal on an eligible free tier if enabled.
INSTANTSTUDY_FREE_VISION_ENABLED=false
INSTANTSTUDY_GEMINI_VISION_MODEL=gemini-2.5-flash

# These 3 switches MUST be explicitly enabled to use any paid OpenAI path
# for text, transcription or image OCR. Default: no paid fallback.
INSTANTSTUDY_ALLOW_PAID_LLM_FALLBACK=false
INSTANTSTUDY_ALLOW_PAID_AUDIO_FALLBACK=false
INSTANTSTUDY_ALLOW_PAID_VISION_FALLBACK=false

# OpenAI remains a separately billed optional provider for WebRTC VOICE
# and explicitly approved paid fallbacks. ChatGPT plan does not cover API usage.
OPENAI_API_KEY=
INSTANTSTUDY_PAID_TEXT_MODEL=gpt-4o-mini
INSTANTSTUDY_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe

# Optional paid OpenAI visual OCR fallback, only when allow_paid_vision is true.
INSTANTSTUDY_VISION_MODEL=gpt-4o-mini

# Free-plan activation limits. Plus remains 20 Learn rounds + 3 tests/month;
# Unlimited has no Learn/Test cap.
INSTANTSTUDY_FREE_LEARN_ROUNDS=5
INSTANTSTUDY_FREE_PRACTICE_TESTS=1

# OWASP HTTP hardening
INSTANTSTUDY_ALLOWED_ORIGINS=http://localhost:5173
INSTANTSTUDY_API_RATE_LIMIT=240
INSTANTSTUDY_MCP_RATE_LIMIT=120
INSTANTSTUDY_BRIDGE_RATE_LIMIT=60

# Optional comma-separated remote-file host allowlist.
# Empty still blocks localhost, metadata endpoints and private/reserved networks.
INSTANTSTUDY_FILE_HOST_ALLOWLIST=

# Unified web billing funnel.
VITE_INSTANT_PAY_URL=https://instant-pay-gamma.vercel.app

# Optional standalone study intelligence. Without configured free provider keys,
# grading/Ask use deterministic/extractive behavior rather than failing.
# Do not silently enable paid OpenAI text inference.
INSTANTSTUDY_LLM_GRADE_CONFIDENCE_THRESHOLD=0.8
INSTANTSTUDY_LLM_ASK_CONFIDENCE_THRESHOLD=0.67


# Google Drive private-file picker (web). The browser client ID/API key are
# public identifiers; restrict the API key to the InstantStudy origins and
# Google Picker/Drive APIs in Google Cloud.
VITE_GOOGLE_DRIVE_CLIENT_ID=
VITE_GOOGLE_DRIVE_API_KEY=
VITE_GOOGLE_DRIVE_APP_ID=
