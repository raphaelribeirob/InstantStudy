PORT=8000

# Development-only single device binding.
# Production must derive the device from authenticated user identity.
INSTANTSTUDY_DEVICE_ID=dev-device
INSTANTSTUDY_BRIDGE_TOKEN=replace-me

# Maximum time an MCP tool waits for the local Anki bridge.
ANKI_COMMAND_TIMEOUT_MS=15000

# Durable study sessions, cross-session mastery and due-review scheduling.
# In production, provision Neon and set the injected DATABASE_URL.
DATABASE_URL=

# Provider-neutral REST/OpenAPI access for non-MCP LLM clients.
INSTANTSTUDY_API_KEY=replace-me-api-key

# Adapty pricing experiments. Leave blank to disable monetization lookup locally.
ADAPTY_PUBLIC_API_KEY=
ADAPTY_SECRET_API_KEY=
ADAPTY_PLACEMENT_ID=instantstudy_main
ADAPTY_STORE=stripe

# Funnel web app. These connect the paywall to the Adapty-backed backend offer endpoint.
VITE_INSTANTSTUDY_API_URL=http://127.0.0.1:8000
VITE_INSTANTSTUDY_API_KEY=replace-me-api-key

# Public origin used to publish MCP/OpenAPI connection metadata.
INSTANTSTUDY_PUBLIC_URL=https://YOUR_INSTANTSTUDY_HOST

# Marketing page connection buttons.
VITE_INSTANTSTUDY_MCP_URL=https://YOUR_INSTANTSTUDY_HOST/mcp
VITE_INSTANTSTUDY_OPENAPI_URL=https://YOUR_INSTANTSTUDY_HOST/openapi.yaml



# Optional: native lecture/audio transcription.
# Without this key, audio remains host_text_required and is never reported as extracted.
OPENAI_API_KEY=
INSTANTSTUDY_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe

# Free-plan activation limits. Plus remains 20 Learn rounds + 3 tests/month;
# Unlimited has no Learn/Test cap.
INSTANTSTUDY_FREE_LEARN_ROUNDS=5
INSTANTSTUDY_FREE_PRACTICE_TESTS=1
