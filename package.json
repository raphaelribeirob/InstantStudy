{
  "name": "instantstudy",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm --workspace apps/mcp-server run dev",
    "dev:web": "npm --workspace apps/web run dev",
    "start": "npm --workspace apps/mcp-server run start",
    "typecheck": "npm --workspace apps/mcp-server run typecheck && npm --workspace apps/web run typecheck && npm --workspace apps/pay run typecheck",
    "build:web": "npm --workspace apps/web run build",
    "dev:pay": "npm --workspace apps/pay run dev",
    "build:pay": "npm --workspace apps/pay run build",
    "security:audit": "npm audit --omit=dev --audit-level=high",
    "build": "npm run build:web && npm run build:pay",
    "test": "npm run test:auth0 && npm --workspace apps/mcp-server run test && npm --workspace apps/pay run test",
    "plugin:check": "node scripts/check-plugin-package.mjs",
    "plugin:release-check": "node scripts/check-plugin-package.mjs --release",
    "auth0:check": "node scripts/check-auth0-discovery.mjs",
    "test:auth0": "node --test integrations/auth0/instantstudy-post-login.test.cjs"
  }
}
